# --- Segredos e credenciais (NUNCA comitar) ---
.env
*.pfx
*.pem
*.p12
*.key

# --- Certificados públicos (pode comitar se quiser, mas não é necessário) ---
# *.cer

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
*.egg

# --- Ambientes virtuais ---
.venv/
venv/
env/
ENV/
.virtualenv/

# --- IDEs ---
.vscode/settings.json
.idea/
*.swp
*.swo
*~

# --- Jupyter ---
.ipynb_checkpoints/
*.ipynb

# --- Logs ---
*.log
logs/

# --- OS ---
.DS_Store
Thumbs.db
desktop.ini

# --- Azure CLI cache (não contém segredos, mas é desnecessário no repo) ---
.azure/
