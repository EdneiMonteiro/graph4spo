# =============================================================================
# Template de variáveis de ambiente — graph4spo
#
# IMPORTANTE: Este arquivo é um template. Copie para .env e preencha os valores.
# O arquivo .env NÃO deve ser comitado no Git (está no .gitignore).
#
# ZERO SEGREDOS neste arquivo:
#   - Todos os API keys ficam armazenados no Azure Key Vault (kv4spo)
#   - O Azure SDK os recupera automaticamente via DefaultAzureCredential
#   - Rode 'az login' antes de executar qualquer script Python
# =============================================================================

# -----------------------------------------------------------------------------
# Identidade — Service Principal registrado pelo script 03_register_sp.ps1
# AZURE_CLIENT_ID é preenchido automaticamente pelo script 03_register_sp.ps1
# -----------------------------------------------------------------------------
# Tenant Azure (onde estão OpenAI, AI Search, Key Vault)
AZURE_TENANT_ID=5bda9e44-74f1-47eb-8741-460273dbb4bf
# Tenant SharePoint (onde está o site 07gc0.sharepoint.com)
SHAREPOINT_TENANT_ID=9b5a6e9d-983c-4d16-8ac4-74f1b29dd8c3
AZURE_CLIENT_ID=

# -----------------------------------------------------------------------------
# Azure Key Vault
# URL pública do Key Vault — não é um segredo.
# Os API keys e endpoints ficam como secrets dentro do Key Vault.
# -----------------------------------------------------------------------------
AZURE_KEYVAULT_URL=https://kv4spo.vault.azure.net/

# Nome do certificado do Service Principal armazenado no Key Vault
# (importado pelo script 03_register_sp.ps1)
KV_CERT_NAME=sp4spo-cert

# -----------------------------------------------------------------------------
# SharePoint Online
# -----------------------------------------------------------------------------
SHAREPOINT_SITE_URL=https://07gc0.sharepoint.com
SHAREPOINT_LIBRARY_NAME=doc4index

# -----------------------------------------------------------------------------
# Azure AI Search — nome do índice (não é segredo)
# Endpoint e API key são lidos do Key Vault em runtime
# -----------------------------------------------------------------------------
AZURE_SEARCH_INDEX_NAME=idx4spo

# -----------------------------------------------------------------------------
# Azure OpenAI — versão da API e nomes de deployment (não são segredos)
# Endpoint e API key são lidos do Key Vault em runtime
# -----------------------------------------------------------------------------
AZURE_OPENAI_API_VERSION=2024-12-01-preview
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small
